{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CipherNest",
  "version": "0.4.2",
  "identifier": "com.ciphernest.vault",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "CipherNest",
        "width": 1240,
        "height": 780,
        "center": true,
        "minWidth": 760,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "devtools": false,
        "backgroundColor": "#101216"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: data:; style-src 'self'; font-src 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "homepage": "https://github.com/qianshulab/CipherNest",
    "shortDescription": "Local-first encrypted password vault",
    "longDescription": "CipherNest is an offline-first encrypted password generator and vault.",
    "copyright": "Copyright 2026 CipherNest contributors",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "hardenedRuntime": true,
      "signingIdentity": "-"
    },
    "windows": {
      "digestAlgorithm": "sha256"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
